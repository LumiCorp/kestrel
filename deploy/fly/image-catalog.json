{
  "version": 1,
  "images": [
    {
      "role": "workspace-runtime",
      "publisher": "ghcr",
      "repository": "ghcr.io/lumicorp/kestrel-workspace-runtime",
      "app": "kestrel-one-runner",
      "config": "apps/workspace-runtime/fly.build.toml",
      "dockerfile": "apps/workspace-runtime/Dockerfile",
      "smoke": "apps/workspace-runtime/scripts/image-smoke.sh",
      "channel": "environment-runtime",
      "rollout": "environment",
      "inputs": [
        "deploy/fly/image-catalog.json",
        ".dockerignore",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "apps/workspace-runtime/**",
        "packages/environment-auth/**",
        "packages/memory/**",
        "packages/mcp-security/**",
        "packages/sdk/**",
        "packages/protocol/**",
        "packages/workspace-skills/**",
        "agents/**",
        "cli/**",
        "models/**",
        "src/**",
        "tools/**",
        "db/**"
      ]
    },
    {
      "role": "environment-router",
      "publisher": "ghcr",
      "repository": "ghcr.io/lumicorp/kestrel-environment-router",
      "app": "kestrel-one-runner",
      "config": "apps/environment-router/fly.build.toml",
      "dockerfile": "apps/environment-router/Dockerfile",
      "smoke": "apps/environment-router/scripts/image-smoke.sh",
      "channel": "environment-runtime",
      "rollout": "environment",
      "inputs": [
        "deploy/fly/image-catalog.json",
        ".dockerignore",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "apps/environment-router/**",
        "packages/environment-auth/**"
      ]
    },
    {
      "role": "preview-edge",
      "publisher": "fly",
      "repository": "registry.fly.io/kestrel-preview-edge",
      "app": "kestrel-preview-edge",
      "config": "apps/preview-edge/fly.build.toml",
      "dockerfile": "apps/preview-edge/Dockerfile",
      "smoke": "apps/preview-edge/scripts/image-smoke.sh",
      "channel": "fly",
      "rollout": "global-app",
      "inputs": [
        "deploy/fly/image-catalog.json",
        ".dockerignore",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "apps/preview-edge/**",
        "packages/environment-auth/**"
      ]
    },
    {
      "role": "turn-worker",
      "publisher": "fly",
      "repository": "registry.fly.io/kestrel-one-turn-worker",
      "app": "kestrel-one-turn-worker",
      "config": "deploy/fly/kestrel-one-turn-worker/fly.toml",
      "dockerfile": "deploy/fly/kestrel-one-turn-worker/Dockerfile",
      "smoke": "deploy/fly/kestrel-one-turn-worker/smoke.sh",
      "channel": "fly",
      "rollout": "global-app",
      "inputs": [
        "deploy/fly/image-catalog.json",
        ".dockerignore",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "apps/web/**",
        "packages/environment-auth/**",
        "packages/mcp-security/**",
        "packages/protocol/**",
        "packages/sdk/**",
        "packages/ai-sdk/**",
        "packages/next/**",
        "packages/workspace-skills/**",
        "deploy/fly/kestrel-one-turn-worker/**"
      ]
    },
    {
      "role": "control-worker",
      "publisher": "fly",
      "repository": "registry.fly.io/kestrel-one-control-worker",
      "app": "kestrel-one-control-worker",
      "config": "deploy/fly/kestrel-one-control-worker/fly.toml",
      "dockerfile": "deploy/fly/kestrel-one-control-worker/Dockerfile",
      "smoke": "deploy/fly/kestrel-one-control-worker/smoke.sh",
      "channel": "fly",
      "rollout": "global-app",
      "inputs": [
        "deploy/fly/image-catalog.json",
        ".dockerignore",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "apps/web/**",
        "packages/environment-auth/**",
        "packages/mcp-security/**",
        "packages/protocol/**",
        "packages/sdk/**",
        "deploy/fly/kestrel-one-control-worker/**"
      ]
    },
    {
      "role": "runpod-worker",
      "publisher": "fly",
      "repository": "registry.fly.io/kestrel-one-runpod-worker",
      "app": "kestrel-one-runpod-worker",
      "config": "deploy/fly/kestrel-one-runpod-worker/fly.toml",
      "dockerfile": "deploy/fly/kestrel-one-runpod-worker/Dockerfile",
      "smoke": "deploy/fly/kestrel-one-runpod-worker/smoke.sh",
      "channel": "runpod",
      "rollout": "global-app",
      "inputs": [
        "deploy/fly/image-catalog.json",
        ".dockerignore",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "apps/web/**",
        "packages/environment-auth/**",
        "deploy/fly/kestrel-one-runpod-worker/**"
      ]
    }
  ]
}
