{
  "name": "@kestrel/preview-edge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @lumi/kestrel-environment-auth build && pnpm run build:self",
    "build:self": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "node --import tsx --test --test-concurrency=4 --test-reporter=spec tests/config.test.ts tests/route-resolver.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 --test-reporter=spec tests/edge.test.ts",
    "typecheck": "pnpm run typecheck:self",
    "typecheck:self": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lumi/kestrel-environment-auth": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
