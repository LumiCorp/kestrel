+pub async fn get_element_local_name_and_type(
+    client: &CdpClient,
+    session_id: &str,
+    ref_map: &RefMap,
+    selector_or_ref: &str,
+    iframe_sessions: &HashMap<String, String>,
+) -> Result<(String, Option<String>), String> {
+    let (object_id, effective_session_id) = resolve_element_object_id(
+        client,
+        session_id,
+        ref_map,
+        selector_or_ref,
+        iframe_sessions,
+    )
+    .await?;
+
+    let described = client
+        .send_command(
+            "DOM.describeNode",
+            Some(serde_json::json!({ "objectId": object_id })),
+            Some(&effective_session_id),
+        )
+        .await?;
+
+    let node = described
+        .get("node")
+        .ok_or_else(|| "Element description is unavailable".to_string())?;
+    let local_name = node
+        .get("localName")
+        .and_then(|value| value.as_str())
+        .filter(|value| !value.is_empty())
+        .map(str::to_string)
+        .ok_or_else(|| "Element localName is unavailable".to_string())?;
+    let attributes = node
+        .get("attributes")
+        .and_then(|value| value.as_array())
+        .ok_or_else(|| "Element attributes are unavailable".to_string())?;
+    if attributes.len() % 2 != 0 {
+        return Err("Element attributes are invalid".to_string());
+    }
+    let input_type = attributes.chunks_exact(2).find_map(|pair| {
+        (pair[0].as_str() == Some("type"))
+            .then(|| pair[1].as_str().map(str::to_string))
+            .flatten()
+    });
+    Ok((local_name, input_type))
+}
